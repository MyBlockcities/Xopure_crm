# Server-side only. NEVER expose these to the browser.

# ── Source selection ────────────────────────────────────────────────────────
# twenty   (default when TWENTY_PG_URL is set) — read the Twenty workspace
#          mirror. Needs NO Supabase credential, and ids deep-link directly.
# supabase — read affiliates.parent_id straight from Supabase.
# demo     — seeded fiction, no database at all.
TREE_SOURCE=twenty

# ── Source: twenty (recommended) ────────────────────────────────────────────
# The Twenty workspace database. On Railway this is the `Postgres` service.
# The LIVE database is `<twenty-database>` — NOT `railway`, which is orphaned.
TWENTY_PG_URL=postgresql://<user>:<password>@<host>:<port>/<twenty-database>

# Required, no default. Live value as of 2026-07-26:
TWENTY_WORKSPACE_SCHEMA=workspace_<your-workspace-id>

# Railway's public Postgres proxy presents a self-signed certificate. This
# disables verification for THIS POOL ONLY. Never set the process-wide
# NODE_TLS_REJECT_UNAUTHORIZED=0 instead — that turns it off everywhere.
# Not needed when connecting over a *.railway.internal host.
TWENTY_PG_SSL_NO_VERIFY=1

# ── Source: supabase (alternative) ──────────────────────────────────────────
# crm_readonly connection string (GRANT SELECT only).
# A service-role credential bypasses RLS and can write — never put one here.
# SUPABASE_DB_URL=postgresql://crm_readonly:...@db.<project>.supabase.co:5432/postgres

# ── Presentation ────────────────────────────────────────────────────────────
# Twenty, for record deep links and the frame-ancestors allowlist.
TWENTY_BASE_URL=https://crm.xopure.com

# Default generations to walk per query.
TREE_MAX_DEPTH=12
